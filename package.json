{
  "name": "open-mat",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "dev:tunnel": "expo start --tunnel",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:member": "expo start",
    "start:coach": "npm run start --workspace=@openmat/coach",
    "start:coach-web": "npm run dev --workspace=@openmat/coach-web",
    "typecheck": "tsc --noEmit",
    "typecheck:coach": "npm run typecheck --workspace=@openmat/coach",
    "typecheck:coach-web": "npm run typecheck --workspace=@openmat/coach-web",
    "typecheck:all": "npm run typecheck && npm run typecheck:coach && npm run typecheck:coach-web",
    "test:coach-web": "npm run test --workspace=@openmat/coach-web",
    "lint": "tsc --noEmit",
    "lint:all": "npm run typecheck:all",
    "start:member:tunnel": "expo start --tunnel --port 8081",
    "start:coach:tunnel": "npm run start --workspace=@openmat/coach -- --tunnel --port 8082",
    "demo:qr": "node scripts/generate-demo-qr.js",
    "eas:member:build:ios": "npx eas-cli build --platform ios --profile production --non-interactive",
    "eas:member:submit:ios": "npx eas-cli submit --platform ios --profile production --latest --non-interactive",
    "eas:member:testflight": "npx eas-cli build --platform ios --profile production --auto-submit --non-interactive",
    "eas:coach:build:ios": "npm run eas:build:ios --workspace=@openmat/coach",
    "eas:coach:submit:ios": "npm run eas:submit:ios --workspace=@openmat/coach",
    "eas:coach:testflight": "npm run eas:testflight --workspace=@openmat/coach"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  }
}
